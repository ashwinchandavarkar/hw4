# Copy this file to `.env` in the project root (hw4/.env) and fill in your key.
# Never commit the real .env — it is excluded by .gitignore.

# Portkey gateway key (required for the chat agent).
PORTKEY_API_KEY=your-portkey-key-here

# Optional overrides (defaults shown).
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=openai
# CAMPUS_CUSTOMS_MODEL=gpt-5.6-luna

# Path to the provided SQLite database (defaults to ./data/campus_customs.db).
# CAMPUS_CUSTOMS_DB=data/campus_customs.db

# PBKDF2 iterations used when hashing NEW account passwords (matches the
# provided database).
# CAMPUS_CUSTOMS_PBKDF2_ITERATIONS=120000

# Secret used to sign session tokens. Set a long random value in production.
# CAMPUS_CUSTOMS_SESSION_SECRET=change-me
